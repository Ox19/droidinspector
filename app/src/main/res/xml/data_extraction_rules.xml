<?xml version="1.0" encoding="utf-8"?><!--
    Los datos de uso del cliente no salen del dispositivo: ni a la nube ni a otro equipo.
    allowBackup=false ya cubre el backup; device-transfer necesita exclusión explícita.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
